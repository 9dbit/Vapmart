+'use client';
+import {useState} from 'react';
+import {useCatalogAdmin} from './catalog-admin-shell';
+export type Lookup={categories:any[];warehouses:any[];brands:any[]};
+export type StockDraft={warehouseId:string;onHand:string;expectedOnHand:number;expectedReserved:number;notes:string};
+export function stockDrafts(lookups:Lookup,rows:any[],productId?:string):StockDraft[]{return lookups.warehouses.filter(w=>w.is_active&&!w.is_system_hold).map(w=>{const row=rows.find(s=>s.product_id===productId&&s.warehouse_id===w.id);return {warehouseId:w.id,onHand:row?String(row.on_hand):'',expectedOnHand:row?.on_hand??0,expectedReserved:row?.reserved??0,notes:''};});}
+export function stockPayload(rows:StockDraft[]){return rows.filter(s=>s.onHand!=='').map(s=>({...s,onHand:Number(s.onHand)}));}
+export function StockFields({value,onChange,lookups}:{value:StockDraft[];onChange:(v:StockDraft[])=>void;lookups:Lookup}){
+ const edit=(i:number,k:keyof StockDraft,v:string)=>onChange(value.map((s,n)=>n===i?{...s,[k]:v}:s));
+ return <div><p className="vc-muted">Isi stok fisik tiap gudang. Kolom kosong tidak mengubah stok. Reservasi tidak diubah; stok tersedia dihitung otomatis. Setiap perubahan memerlukan catatan.</p>
+ {!value.length?<p role="status">Belum ada gudang fisik aktif. Tambahkan melalui Gudang & Stok; produk tetap dapat disimpan sebagai draft.</p>:<div className="vc-table-wrap"><table className="vc-table"><thead><tr><th>Gudang</th><th>Stok fisik</th><th>Direservasi</th><th>Tersedia</th><th>Catatan perubahan</th></tr></thead><tbody>{value.map((s,i)=>{const w=lookups.warehouses.find(w=>w.id===s.warehouseId);return <tr key={s.warehouseId}><td><strong>{w?.name}</strong><br/><small>{w?.code} {w?.is_dispatch_enabled?'':' / Dispatch OFF'}</small></td><td><input aria-label={'Stok '+w?.name} type="number" min={s.expectedReserved} step="1" value={s.onHand} placeholder="Tidak diubah" onChange={e=>edit(i,'onHand',e.target.value)}/></td><td>{s.expectedReserved}</td><td>{s.onHand===''?'-':Number(s.onHand)-s.expectedReserved}</td><td><input className="vc-stock-note" aria-label={'Catatan stok '+w?.name} value={s.notes} maxLength={300} placeholder="Referensi penerimaan / koreksi" onChange={e=>edit(i,'notes',e.target.value)}/></td></tr>;})}</tbody></table></div>}
+ </div>;
+}
+export function ImagesField({value,onChange}:{value:string[];onChange:(v:string[])=>void}){
+ const {upload}=useCatalogAdmin();const [busy,setBusy]=useState(false),[error,setError]=useState(''),[url,setUrl]=useState('');
+ async function files(selected:File[]){setBusy(true);setError('');try{const next=[...value];if(next.length+selected.length>21)throw Error('Maksimal satu utama dan 20 gambar pendukung');for(const file of selected)next.push(await upload(file));onChange([...new Set(next)]);}catch(e){setError((e as Error).message);}finally{setBusy(false);}}
+ return <div><label>Upload gambar utama dan pendukung<input type="file" accept="image/png,image/jpeg,image/webp" multiple disabled={busy} onChange={e=>{void files(Array.from(e.target.files||[]));e.target.value='';}}/></label><p className="vc-muted">Gambar pertama menjadi gambar utama. JPG, PNG, WebP, maksimal 1,5 MiB per file. File tetap tersimpan saat dilepas dari produk.</p>
+ {busy&&<p role="status">Mengunggah gambar...</p>}{error&&<p role="alert" className="vc-alert">{error}</p>}
+ <div className="vc-photos">{value.map((src,i)=><div className="vc-photo" key={src}><a href={src} target="_blank" rel="noreferrer"><img src={src} alt={'Preview '+(i+1)}/></a><strong>{i===0?'Gambar utama':'Pendukung '+i}</strong><div className="vc-actions">{i>0&&<button type="button" onClick={()=>onChange([src,...value.filter((_,j)=>j!==i)])}>Jadikan utama</button>}<button type="button" disabled={i===0} aria-label={'Naik gambar '+(i+1)} onClick={()=>{const a=[...value];[a[i-1],a[i]]=[a[i],a[i-1]];onChange(a);}}>Naik</button><button type="button" onClick={()=>onChange(value.filter((_,j)=>j!==i))}>Lepaskan</button></div></div>)}</div>
+ <details><summary>Gunakan URL gambar HTTPS</summary><div className="vc-actions"><input aria-label="URL gambar" value={url} onChange={e=>setUrl(e.target.value)} placeholder="https://..."/><button type="button" onClick={()=>{try{const u=new URL(url);if(u.protocol!=='https:'||u.username||u.password||u.hash||value.length>=21)throw Error();onChange([...new Set([...value,url.trim()])]);setUrl('');setError('');}catch{setError('URL HTTPS valid diperlukan, maksimal 21 gambar');}}}>Tambahkan URL</button></div></details></div>;
+}
+export const inputDate=(v:unknown)=>{if(!v)return '';const d=new Date(String(v));return Number.isNaN(d.valueOf())?'':new Date(d.valueOf()+7*3600000).toISOString().slice(0,16);};
