+function headers(text:string){const result:string[]=[];let cell='',quote=false;for(let i=0;i<text.length;i++){const c=text[i];if(c==='"'){if(quote&&text[i+1]==='"'){cell+='"';i++;}else quote=!quote;}else if(!quote&&(c===','||c==='\n'||c==='\r')){result.push(cell.trim().replace(/^\uFEFF/,''));cell='';if(c!==',')return result;}else cell+=c;}if(cell)result.push(cell.trim());return result;}
