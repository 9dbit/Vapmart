+ function report(){const rows=[...(preview?.errors||[]).map((x:any)=>({...x,type:'error'})),...(preview?.warnings||[]).map((x:any)=>({...x,type:'warning'}))];download('vapmart-import-validation.csv',[['type','row','field','message'].map(safeCell).join(','),...rows.map((r:any)=>[r.type,r.row,r.field,r.message].map(safeCell).join(','))].join('\r\n'));}
+ const reset=()=>{setPreview(null);setResult(null)};
+ return <><div className="vc-toolbar"><h2>Impor Produk</h2><Link className="vc-button" href="/admin/products">Kembali ke daftar</Link></div><CatalogNotice error={error}/><section className="vc-panel"><h2>1. File dan sumber</h2><p className="vc-muted">CSV UTF-8, maksimal 2 MiB / 2.000 baris. Induk variable dan variation harus berada dalam file yang sama. File hanya dianalisis sampai Anda mengonfirmasi impor.</p><div className="vc-grid"><label>File CSV<input type="file" accept=".csv,text/csv" disabled={busy} onChange={e=>{const f=e.target.files?.[0];if(f)void readFile(f)}}/></label><label>Nama sumber stabil<input value={source} maxLength={80} onChange={e=>{setSource(e.target.value);reset()}}/><small>Gunakan nama yang sama untuk impor ulang sumber yang sama.</small></label><label>Mode impor<select value={mode} onChange={e=>{setMode(e.target.value);reset()}}><option value="create">Tambah baru, tolak data existing</option><option value="upsert">Tambah / perbarui berdasarkan ID sumber atau SKU</option></select></label><label>Gudang tujuan kolom Stock<select value={warehouse} onChange={e=>{setWarehouse(e.target.value);reset()}}><option value="">Belum dipilih</option>{lookups?.warehouses.filter(w=>w.is_active&&!w.is_system_hold).map(w=><option key={w.id} value={w.id}>{w.name}</option>)}</select></label></div><p>Stok kosong tidak mengubah saldo. Angka <strong>0</strong> berarti set stok fisik menjadi nol dan tetap harus lolos pemeriksaan reservasi.</p><button type="button" onClick={()=>download('vapmart-products-template.csv','ID,Type,SKU,Name,Regular price,Sale price,Stock,Categories,Images,Parent,Attribute 1 name,Attribute 1 value(s),Attribute 2 name,Attribute 2 value(s),Attribute 3 name,Attribute 3 value(s)\r\n')}>Unduh template kosong</button></section>
+ {columns.length>0&&<section className="vc-panel"><h2>2. Cocokkan kolom</h2><p>{filename} | {columns.length} kolom</p><div className="vc-grid vc-grid-3">{Object.entries(fields).map(([k,label])=><label key={k}>{label}<select value={mapping[k]||''} disabled={busy} onChange={e=>{setMapping({...mapping,[k]:e.target.value});reset()}}><option value="">Tidak dipetakan</option>{columns.map(c=><option key={c} value={c}>{c}</option>)}</select></label>)}</div><details className="vc-panel"><summary>Pemetaan tambahan stok multi-gudang</summary><p>Hubungkan kolom khusus, misalnya Stock Jakarta dan Stock Bandung. Jangan memetakan dua kolom ke gudang yang sama.</p><div className="vc-grid">{columns.map(c=><label key={c}>{c}<select value={warehouseColumns[c]||''} onChange={e=>{setWarehouseColumns({...warehouseColumns,[c]:e.target.value});reset()}}><option value="">Bukan stok gudang tambahan</option>{lookups?.warehouses.filter(w=>w.is_active&&!w.is_system_hold).map(w=><option key={w.id} value={w.id}>{w.name}</option>)}</select></label>)}</div></details><button type="button" className="vc-primary" disabled={busy||!csv} onClick={validate}>{busy?'Memproses...':'Validasi dan preview'}</button></section>}
+ {preview&&<section className="vc-panel"><h2>3. Preview hasil</h2><div className="vc-stats">{[['Produk utama',preview.summary.products],['Varian',preview.summary.variants],['Error',preview.summary.errors],['Peringatan',preview.summary.warnings]].map(([label,n])=><div key={label}><small>{label}</small><strong>{n}</strong></div>)}</div><p>Produk baru disimpan sebagai draft; status produk existing dipertahankan. Brand yang tidak cocok tidak membuat akses partner baru. URL gambar tidak diunduh server secara otomatis.</p><p>Berlaku sampai {new Date(preview.expiresAt).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'})} WIB.</p><div className="vc-actions"><button onClick={report}>Unduh laporan validasi</button><button className="vc-primary" disabled={busy||preview.summary.errors>0||preview.state==='applied'} onClick={apply}>{preview.state==='applied'?'Sudah diimpor':'Konfirmasi impor'}</button></div><div className="vc-table-wrap"><table className="vc-table"><thead><tr><th>Record CSV</th><th>Tipe</th><th>Nama / SKU</th><th>Tindakan</th><th>Stok angka</th></tr></thead><tbody>{preview.rows.map((r:any)=><tr key={r.row}><td>{r.row}</td><td>{r.type}</td><td>{r.name}<br/>{r.sku}</td><td>{r.action}</td><td>{r.stockSpecified?'Ya':'Tidak diubah'}</td></tr>)}</tbody></table></div><details open={preview.errors.length>0}><summary>Error dan peringatan ({preview.errors.length+preview.warnings.length})</summary><div className="vc-table-wrap"><table className="vc-table"><thead><tr><th>Jenis</th><th>Record</th><th>Kolom</th><th>Keterangan</th></tr></thead><tbody>{[...preview.errors.map((x:any)=>({...x,type:'Error'})),...preview.warnings.map((x:any)=>({...x,type:'Peringatan'}))].map((r:any,i:number)=><tr className={r.type==='Error'?'vc-error-row':''} key={i}><td>{r.type}</td><td>{r.row}</td><td>{r.field}</td><td>{r.message}</td></tr>)}</tbody></table></div></details></section>}
+ {(result||preview?.report)&&<section className="vc-panel"><h2>Impor selesai</h2><pre style={{whiteSpace:'pre-wrap'}}>{JSON.stringify(result||preview.report,null,2)}</pre><button onClick={()=>download('vapmart-import-result.json',JSON.stringify(result||preview.report,null,2),'application/json')}>Unduh hasil impor</button><Link className="vc-button" href="/admin/products">Lihat produk</Link></section>}
+ </>;
+}
