NODE_ENV=development
PORT=4000
# Railway PostgreSQL URL; unset means empty read-only catalog, no checkout.
DATABASE_URL=
# Supabase Auth, not a second auth schema copied into Railway PostgreSQL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated allowed browser origins; unset disables cross-origin access.
WEB_ORIGIN=http://localhost:3000

# Order administration (does not enable checkout or payment capture).
ORDER_MANAGEMENT_ENABLED=true
INVOICE_STORE_NAME=Vapmart
# Set the actual billing identity; empty fields are omitted from invoices.
INVOICE_STORE_ADDRESS=
INVOICE_STORE_EMAIL=
INVOICE_STORE_PHONE=
